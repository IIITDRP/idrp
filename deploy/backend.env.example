# /etc/idrp/backend.env  -  owner root:idrp, mode 640. NEVER commit the real file.
SPRING_PROFILES_ACTIVE=prod

DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/idrp_db
DATABASE_USERNAME=idrp_app
DATABASE_PASSWORD=change-me

# openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=change-me

# First start only: creates the SUPER_ADMIN if the admins table is empty.
# Remove both lines after the first login, and change the password in the panel.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# true on the very first start to import the website content, then set back to false.
SEED_STATIC_DATA=false

UPLOAD_DIR=/var/idrp/uploads
UPLOAD_BASE_URL=https://www.idrp.in/uploads
CORS_ALLOWED_ORIGINS=https://www.idrp.in,https://idrp.in
PUBLIC_SITE_URL=https://www.idrp.in

# Optional: e-mail the team about each new inquiry (Hostinger mailbox SMTP).
MAIL_HOST=
MAIL_PORT=465
MAIL_SSL=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
INQUIRY_NOTIFY_TO=
