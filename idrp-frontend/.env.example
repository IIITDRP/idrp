# Copy to .env for local development.

# Backend origin (no trailing slash). Leave EMPTY in production: nginx serves the site
# and proxies /api and /uploads to the backend on the same domain.
VITE_API_BASE_URL=http://localhost:8080

# 'api' (default): pages show the bundled static data instantly, then live data from
# the backend. 'static': never call the API (static-only build).
VITE_CONTENT_SOURCE=api

# Public site origin for canonical URLs, OpenGraph tags and sitemap.xml.
VITE_SITE_URL=https://www.idrp.in

# Web3Forms (https://web3forms.com) access key. Used ONLY as a fallback when the backend
# cannot take a form submission. Web3Forms keys are designed to be public.
VITE_WEB3FORMS_ACCESS_KEY=

# Microsoft Clarity project id. Clarity loads only after the visitor consents.
VITE_CLARITY_PROJECT_ID=w7wtk63nfq
