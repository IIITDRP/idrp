# Production build settings (committed - contains no secrets).
# Built on the VPS by deploy/deploy.sh; nginx serves dist/ and proxies /api + /uploads.

# Empty = same origin (https://www.idrp.in/api/...). No CORS needed.
VITE_API_BASE_URL=
VITE_CONTENT_SOURCE=api
VITE_SITE_URL=https://www.idrp.in
VITE_CLARITY_PROJECT_ID=w7wtk63nfq

# VITE_WEB3FORMS_ACCESS_KEY (fallback e-mail relay) is supplied at build time from
# /etc/idrp/frontend.env on the server, not committed here.
